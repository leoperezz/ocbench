    <asset>
        <material name="hanoi_peg" rgba="0.96 0.965 0.96 1" shininess="0.1" reflectance="0.02" specular="0.03"/>
    </asset>

    <default>
        <default class="hanoi_peg">
            <geom type="box" material="hanoi_peg" solref="0.004 1" group="1"/>
        </default>
        <default class="hanoi_disk">
            <geom type="box" density="100" solref="0.02 1" group="1"/>
            <site type="sphere" size=".005" rgba="0 1 0 1" group="5"/>
        </default>
    </default>

    <worldbody>
    </worldbody>
</mujoco>
